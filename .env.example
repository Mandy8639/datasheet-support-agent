# Copy to .env (make setup does this). Never commit .env.

# --- Postgres (docker compose + app) ---
POSTGRES_USER=datasheet
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=datasheets
POSTGRES_PORT=5433

# Admin connection: ingestion and index scripts only. The agent never uses it.
DATABASE_URL=postgresql://datasheet:change-me-admin@localhost:5433/datasheets

# Read-only role for the agent (created on first container start).
AGENT_DB_PASSWORD=change-me-agent
AGENT_DATABASE_URL=postgresql://agent_ro:change-me-agent@localhost:5433/datasheets

# --- LLM (Phase 5) ---
# Free OpenRouter models first, with failover; optional Claude Haiku behind a daily cap.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
DAILY_SPEND_CAP_USD=1.00
