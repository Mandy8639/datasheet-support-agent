# Copy to .env (make setup does this). Never commit .env.

# --- Postgres (docker compose + app) ---
POSTGRES_USER=datasheet
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=datasheets
POSTGRES_PORT=5433

# Admin connection: ingestion and index scripts only. The agent never uses it.
DATABASE_URL=postgresql://datasheet:change-me-admin@localhost:5433/datasheets

# Read-only role for the agent (created on first container start).
AGENT_DB_PASSWORD=change-me-agent
AGENT_DATABASE_URL=postgresql://agent_ro:change-me-agent@localhost:5433/datasheets

# --- LLM (Phase 5): OpenRouter only ---
# Paste your key after the = sign (no quotes, no spaces). Get one at openrouter.ai/keys.
OPENROUTER_API_KEY=
# Free models, tried in order; the next one is used on a rate limit, server error or timeout.
# Filled in during Phase 5 after checking which free models are currently available.
OPENROUTER_MODELS=particle-ai/particle-1:free,baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-super-vl:free
# Hard stop for any paid usage (free models cost $0).
DAILY_SPEND_CAP_USD=0.00
